<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>自定义 VPN 配置</string>
    <key>PayloadIdentifier</key>
    <string>com.newvpn.app.config</string>
    <key>PayloadUUID</key>
    <string>11111111-2222-3333-4444-555555555555</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>

    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key>
            <string>我的自定义 VPN</string>
            <key>PayloadIdentifier</key>
            <string>com.newvpn.app.config.vpn</string>
            <key>PayloadUUID</key>
            <string>66666666-7777-8888-9999-000000000000</string>
            <key>PayloadType</key>
            <string>com.apple.vpn.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>UserDefinedName</key>
            <string>NewVPN</string>

            <!-- 使用自定义 VPN 插件 -->
            <key>VPNType</key>
            <string>VPN</string>

            <!-- 这里是你的 Packet Tunnel Provider 扩展的 Bundle Identifier -->
            <!-- 通常为 App Bundle ID + .PacketTunnel 或类似后缀 -->
            <key>VPNSubType</key>
            <string>com.newvpn.app.PacketTunnel</string>

            <!-- 主 App 的 Bundle Identifier -->
            <key>ProviderBundleIdentifier</key>
            <string>com.newvpn.app</string>

            <!-- 自定义参数，由你的 Packet Tunnel Provider 代码解析 -->
            <key>VendorConfig</key>
            <dict>
                <key>Server</key>
                <string>127.0.0.1</string>
                <key>Port</key>
                <string>51820</string>
                <!-- 按你的协议继续添加其他键值，例如用户名、密码、协议等 -->
            </dict>

            <!-- 可选：按需连接 -->
            <key>OnDemandEnabled</key>
            <integer>0</integer>
        </dict>
    </array>
</dict>
</plist>