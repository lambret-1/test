<plist version="1.0">
<dict>
  <key>PayloadDisplayName</key>
  <string>公司VPN配置</string>
  <key>PayloadIdentifier</key>
  <string>com.yourcompany.vpn</string>
  <key>PayloadUUID</key>
  <string>285aab36-5070-11e8-b56d-4384de5d255</string>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadVersion</key>
  <integer>1</integer>

  <key>PayloadContent</key>
  <array>
    <dict>
      <key>PayloadIdentifier</key>
      <string>com.yourcompany.vpn.ikev2</string>
      <key>PayloadUUID</key>
      <string>1a5e58de-5070-11e8-84df-2300f4c55bae</string>
      <key>PayloadType</key>
      <string>com.apple.vpn.managed</string>
      <key>PayloadVersion</key>
      <integer>1</integer>

      <key>UserDefinedName</key>
      <string>公司VPN</string>
      <key>VPNType</key>
      <string>IKEv2</string>

      <key>IKEv2</key>
      <dict>
        <key>RemoteAddress</key>
        <string>vpn.example.com</string>
        <key>RemoteIdentifier</key>
        <string>vpn.example.com</string>
        <key>LocalIdentifier</key>
        <string></string>

        <key>ServerCertificateIssuerCommonName</key>
        <string>Public Root CA</string>
        <key>ServerCertificateCommonName</key>
        <string>vpn.example.com</string>

        <key>AuthenticationMethod</key>
        <string>Certificate</string>
        <key>ExtendedAuthEnabled</key>
        <integer>1</integer>
        <key>AuthName</key>
        <string>username</string>
        <key>AuthPassword</key>
        <string>password</string>

        <key>PayloadCertificateUUID</key>
        <string>REPLACE-WITH-CERT-UUID</string>
        <key>DisableRedirect</key>
        <integer>1</integer>
        <key>EnablePFS</key>
        <integer>1</integer>
      </dict>
    </dict>
  </array>
</dict>
